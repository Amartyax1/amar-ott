# Leave BOT_TOKEN empty to run in demo (mock) mode: seeded catalog, one-click demo login,
# and "sends" are printed by the bot process instead of delivered.

# From @BotFather (/newbot)
BOT_TOKEN=
# Your bot's username without the @, used for t.me login links
BOT_USERNAME=

# The private group (you + the bot) where you upload movies. Send /chatid in the group to get it.
# Group ids look like -1001234567890.
VAULT_CHAT_ID=

# Signs login sessions. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Public URL of the website (used in bot messages and for secure cookies on https)
SITE_URL=http://localhost:4317

# Optional: posters, backdrops, synopses and genres. v3 API key or v4 read access token from themoviedb.org
TMDB_API_KEY=

# Who can log in. Members of the vault group and people who already logged in are always allowed.
# Comma-separated Telegram user ids that may log in without an invite code:
ALLOWED_USER_IDS=
# Set to true to let anyone who finds the bot log in (not recommended)
OPEN_REGISTRATION=false

# Max files a single user can request per hour
SEND_LIMIT_PER_HOUR=40

# SQLite file shared by the website and the bot
DATABASE_PATH=data/reelvault.db
